[
  {"id":"t5u1-01","track":"T","module":"T5","unit":1,"type":"SAY","en":"I understand your concern.","pl":"Rozumiem Pana obawy.","hint_pl":"Deeskalacja — pokazanie, że słuchasz.","variants":{"alt":[]},"register":"polite","red":true,"tags":["clientcontrol"]},
  {"id":"t5u1-02","track":"T","module":"T5","unit":1,"type":"SAY","en":"Let's find a solution together.","pl":"Znajdźmy razem rozwiązanie.","hint_pl":"Przejście z konfliktu do współpracy.","variants":{"alt":[]},"register":"polite","red":true,"tags":["clientcontrol"]},
  {"id":"t5u1-03","track":"T","module":"T5","unit":1,"type":"SAY","en":"That wasn't part of the original plan.","pl":"To nie było częścią pierwotnego planu.","hint_pl":"Grzeczne zaznaczenie zmiany zakresu (scope creep).","variants":{"alt":[]},"register":"neutral","red":true,"tags":["clientcontrol"]},
  {"id":"t5u1-04","track":"T","module":"T5","unit":1,"type":"SAY","en":"We can do that, but it's an extra cost.","pl":"Możemy to zrobić, ale to dodatkowy koszt.","hint_pl":"Ustalanie granic bez konfliktu.","variants":{"alt":[]},"register":"neutral","red":true,"tags":["clientcontrol"]},
  {"id":"t5u1-05","track":"T","module":"T5","unit":1,"type":"HEAR","en":"This isn't what we agreed on.","pl":"To nie jest to, na co się umawialiśmy.","reply":"I understand your concern, let's check the details.","hint_pl":"Klient zgłasza niezgodność z umową.","variants":{"alt":[]},"register":"neutral","red":true,"tags":["clientcontrol"]},
  {"id":"t5u2-01","track":"T","module":"T5","unit":2,"type":"SAY","en":"I'm sorry for the inconvenience.","pl":"Przepraszam za niedogodność.","hint_pl":"Krótkie, szczere przeprosiny bez usprawiedliwiania się.","variants":{"alt":[]},"register":"polite","red":true,"tags":["clientcontrol","complaint"]},
  {"id":"t5u2-02","track":"T","module":"T5","unit":2,"type":"SAY","en":"We'll fix this right away.","pl":"Naprawimy to od razu.","hint_pl":"Konkretna, szybka reakcja na reklamację.","variants":{"alt":["We'll fix it."]},"register":"neutral","red":true,"tags":["clientcontrol","complaint"]},
  {"id":"t5u2-03","track":"T","module":"T5","unit":2,"type":"SAY","en":"Give me a moment to look into it.","pl":"Daj mi chwilę, żeby to sprawdzić.","hint_pl":"Zyskanie czasu na diagnozę problemu.","variants":{"alt":[]},"register":"neutral","red":false,"tags":["clientcontrol","complaint"]},
  {"id":"t5u2-04","track":"T","module":"T5","unit":2,"type":"HEAR","en":"This is not acceptable.","pl":"To jest nie do zaakceptowania.","reply":"I'm sorry, we'll fix this right away.","hint_pl":"Ostra reakcja klienta na problem.","variants":{"alt":[]},"register":"neutral","red":true,"tags":["clientcontrol","complaint"]},
  {"id":"t5u3-01","track":"T","module":"T5","unit":3,"type":"SAY","en":"With respect, that's not possible today.","pl":"Z całym szacunkiem, to nie jest możliwe dzisiaj.","hint_pl":"Asertywna odmowa bez konfliktu.","variants":{"alt":[]},"register":"polite","red":true,"tags":["clientcontrol","boundaries"]},
  {"id":"t5u3-02","track":"T","module":"T5","unit":3,"type":"SAY","en":"Let's stick to the original plan for now.","pl":"Trzymajmy się na razie pierwotnego planu.","hint_pl":"Utrzymanie kontroli nad zakresem prac.","variants":{"alt":[]},"register":"neutral","red":true,"tags":["clientcontrol","boundaries"]},
  {"id":"t5u3-03","track":"T","module":"T5","unit":3,"type":"SAY","en":"I need to say no to that.","pl":"Muszę powiedzieć na to nie.","hint_pl":"Krótka, jasna odmowa.","variants":{"alt":[]},"register":"neutral","red":true,"tags":["clientcontrol","boundaries"]},
  {"id":"t5u3-04","track":"T","module":"T5","unit":3,"type":"HEAR","en":"Can you just do it my way?","pl":"Może Pan po prostu zrobić to po mojemu?","reply":"With respect, that's not possible today.","hint_pl":"Klient próbuje narzucić własne rozwiązanie techniczne.","variants":{"alt":[]},"register":"neutral","red":true,"tags":["clientcontrol","boundaries"]},
  {"id":"t5u4-01","track":"T","module":"T5","unit":4,"type":"SAY","en":"Let's keep this professional.","pl":"Zachowajmy to na poziomie profesjonalnym.","hint_pl":"Deeskalacja podniesionego głosu.","variants":{"alt":[]},"register":"neutral","red":true,"tags":["clientcontrol","conflict"]},
  {"id":"t5u4-02","track":"T","module":"T5","unit":4,"type":"SAY","en":"I hear you, let's take a step back.","pl":"Słyszę Pana, zróbmy krok wstecz.","hint_pl":"Uspokojenie eskalującej sytuacji.","variants":{"alt":[]},"register":"polite","red":true,"tags":["clientcontrol","conflict"]},
  {"id":"t5u4-03","track":"T","module":"T5","unit":4,"type":"HEAR","en":"I want to speak to your boss.","pl":"Chcę porozmawiać z Pana szefem.","reply":"Of course, let me call my manager.","hint_pl":"Eskalacja do wyższego szczebla.","variants":{"alt":[]},"register":"neutral","red":true,"tags":["clientcontrol","conflict"]}
]
