  {"id":"t7u2-15","track":"T","module":"T7","unit":2,"type":"HEAR","en":"There's a small change.","pl":"Jest mała zmiana.","hint_pl":"Uwaga — poproś, żeby pokazał na rysunku.","variants":{"alt":[]},"register":"polite","red":false,"tags":["stoisko","client"],"reply":"Okay, show me, please."},
