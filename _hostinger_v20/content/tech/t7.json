  {"id":"t7u5-11","track":"T","module":"T7","unit":5,"type":"SAY","en":"Lay them face down on the blankets.","pl":"Połóż je frontem na kocach.","hint_pl":"Face down = frontem w dół. Ustal, jak kładziecie Twoje panele.","variants":{"alt":[]},"register":"casual","red":false,"tags":["stoisko","crew"]},
  {"id":"t7u5-12","track":"T","module":"T7","unit":5,"type":"SAY","en":"Let's take a break. Ten minutes.","pl":"Zróbmy przerwę. Dziesięć minut.","hint_pl":"Break = przerwa.","variants":{"alt":[]},"register":"casual","red":false,"tags":["stoisko","crew"]},
  {"id":"t7u5-13","track":"T","module":"T7","unit":5,"type":"SAY","en":"Good job, thanks a lot!","pl":"Dobra robota, wielkie dzięki!","hint_pl":"Chwal często — stagehand pracuje lepiej.","variants":{"alt":[]},"register":"casual","red":false,"tags":["stoisko","crew"]},
  {"id":"t7u5-14","track":"T","module":"T7","unit":5,"type":"HEAR","en":"Where do you want this?","pl":"Gdzie to postawić?","hint_pl":"Najczęstsze pytanie stagehanda.","variants":{"alt":[]},"register":"casual","red":false,"tags":["stoisko","crew"],"reply":"Over there, next to the wall."},
  {"id":"t7u5-15","track":"T","module":"T7","unit":5,"type":"HEAR","en":"Is this heavy?","pl":"Czy to jest ciężkie?","hint_pl":"Heavy = ciężki.","variants":{"alt":[]},"register":"casual","red":false,"tags":["stoisko","crew"],"reply":"Yes, let's lift it together."},
  {"id":"t7u5-16","track":"T","module":"T7","unit":5,"type":"HEAR","en":"What should I do next?","pl":"Co mam robić dalej?","hint_pl":"Miej zawsze następne zadanie w głowie.","variants":{"alt":[]},"register":"casual","red":false,"tags":["stoisko","crew"],"reply":"Open the next case, please."},
  {"id":"t7u5-17","track":"T","module":"T7","unit":5,"type":"HEAR","en":"Can I take a break?","pl":"Mogę zrobić przerwę?","hint_pl":"","variants":{"alt":[]},"register":"casual","red":false,"tags":["stoisko","crew"],"reply":"Sure, ten minutes."},
  {"id":"t7u6-01","track":"T","module":"T7","unit":6,"type":"SAY","en":"First, we mount the hanging bar.","pl":"Najpierw montujemy belkę do zawieszenia.","hint_pl":"Hanging bar / flying bar = belka nośna ekranu.","variants":{"alt":[]},"register":"casual","red":true,"tags":["stoisko","crew"]},
  {"id":"t7u6-02","track":"T","module":"T7","unit":6,"type":"SAY","en":"Put the clamps on the beam here.","pl":"Załóż obejmy na belkę tutaj.","hint_pl":"Clamp = obejma / zacisk.","variants":{"alt":[]},"register":"casual","red":true,"tags":["stoisko","crew"]},
  {"id":"t7u6-03","track":"T","module":"T7","unit":6,"type":"SAY","en":"Tighten it, but not too much.","pl":"Dokręć, ale nie za mocno.","hint_pl":"Tighten = dokręcić. Loosen = poluzować.","variants":{"alt":[]},"register":"casual","red":true,"tags":["stoisko","crew"]},
  {"id":"t7u6-04","track":"T","module":"T7","unit":6,"type":"SAY","en":"Pass me the shackle, please.","pl":"Podaj mi szeklę, proszę.","hint_pl":"Shackle = szekla. „Pass me…” = podaj mi.","variants":{"alt":[]},"register":"casual","red":false,"tags":["stoisko","crew"]},
  {"id":"t7u6-05","track":"T","module":"T7","unit":6,"type":"SAY","en":"Hand me the spanner, please.","pl":"Podaj mi klucz, proszę.","hint_pl":"UK: spanner, US: wrench.","variants":{"uk":"Hand me the spanner, please.","us":"Hand me the wrench, please."},"register":"casual","red":false,"tags":["stoisko","crew"]},
  {"id":"t7u6-06","track":"T","module":"T7","unit":6,"type":"SAY","en":"Now we hang the first panel.","pl":"Teraz wieszamy pierwszy panel.","hint_pl":"Zaczynaj od środka albo od lewej — powiedz to głośno.","variants":{"alt":[]},"register":"casual","red":true,"tags":["stoisko","crew"]},
  {"id":"t7u6-07","track":"T","module":"T7","unit":6,"type":"SAY","en":"Lift on three. One, two, three!","pl":"Podnosimy na trzy. Raz, dwa, trzy!","hint_pl":"Standardowa komenda przy wspólnym podnoszeniu.","variants":{"alt":[]},"register":"casual","red":true,"tags":["stoisko","crew"]},
  {"id":"t7u6-08","track":"T","module":"T7","unit":6,"type":"SAY","en":"Hold it there. Don't move.","pl":"Trzymaj tak. Nie ruszaj.","hint_pl":"Hold = trzymaj.","variants":{"alt":[]},"register":"casual","red":true,"tags":["stoisko","crew"]},
  {"id":"t7u6-09","track":"T","module":"T7","unit":6,"type":"SAY","en":"A bit to the left.","pl":"Trochę w lewo.","hint_pl":"Right = w prawo.","variants":{"alt":[]},"register":"casual","red":true,"tags":["stoisko","crew"]},
  {"id":"t7u6-10","track":"T","module":"T7","unit":6,"type":"SAY","en":"Up a little. Stop!","pl":"Trochę wyżej. Stop!","hint_pl":"Down a little = trochę niżej.","variants":{"alt":[]},"register":"casual","red":true,"tags":["stoisko","crew"]},
  {"id":"t7u6-11","track":"T","module":"T7","unit":6,"type":"SAY","en":"Lock it. Check both locks.","pl":"Zablokuj. Sprawdź oba zamki.","hint_pl":"Lock = zamek / zablokować.","variants":{"alt":[]},"register":"casual","red":true,"tags":["stoisko","crew"]},
  {"id":"t7u6-12","track":"T","module":"T7","unit":6,"type":"SAY","en":"Now the safety wire, please.","pl":"Teraz linka zabezpieczająca.","hint_pl":"Safety (wire) = zabezpieczenie wtórne. Każdy element!","variants":{"alt":[]},"register":"casual","red":true,"tags":["stoisko","crew"]},
  {"id":"t7u6-13","track":"T","module":"T7","unit":6,"type":"SAY","en":"Is it straight? Check the level.","pl":"Równo? Sprawdź poziomicą.","hint_pl":"Level = poziomica / poziom.","variants":{"alt":[]},"register":"casual","red":false,"tags":["stoisko","crew"]},
  {"id":"t7u6-14","track":"T","module":"T7","unit":6,"type":"SAY","en":"Clear the area under the screen.","pl":"Odsuńcie się spod ekranu.","hint_pl":"Nikt nie stoi pod wiszącym ciężarem.","variants":{"alt":[]},"register":"casual","red":true,"tags":["stoisko","crew"]},
  {"id":"t7u6-15","track":"T","module":"T7","unit":6,"type":"SAY","en":"Heads!","pl":"Uwaga z góry!","hint_pl":"Krzyczysz, gdy coś może spaść z góry. Wszyscy odskakują.","variants":{"alt":[]},"register":"casual","red":true,"tags":["stoisko","crew","short"]},
  {"id":"t7u6-16","track":"T","module":"T7","unit":6,"type":"SAY","en":"Watch your hands!","pl":"Uważaj na ręce!","hint_pl":"Przy zamkach i zaciskach.","variants":{"alt":[]},"register":"casual","red":false,"tags":["stoisko","crew"]},
  {"id":"t7u6-17","track":"T","module":"T7","unit":6,"type":"SAY","en":"Don't stand under me, please.","pl":"Nie stój pode mną, proszę.","hint_pl":"Gdy pracujesz na rusztowaniu.","variants":{"alt":[]},"register":"casual","red":true,"tags":["stoisko","crew"]},
  {"id":"t7u6-18","track":"T","module":"T7","unit":6,"type":"HEAR","en":"Is this tight enough?","pl":"Tak wystarczy dokręcić?","hint_pl":"Tight = mocno dokręcone.","variants":{"alt":[]},"register":"casual","red":false,"tags":["stoisko","crew"],"reply":"One more turn, then it's good."},
  {"id":"t7u6-19","track":"T","module":"T7","unit":6,"type":"HEAR","en":"Which way up?","pl":"Którą stroną do góry?","hint_pl":"Pyta o orientację panelu.","variants":{"alt":[]},"register":"casual","red":false,"tags":["stoisko","crew"],"reply":"Arrow up, LEDs to the front."},
  {"id":"t7u6-20","track":"T","module":"T7","unit":6,"type":"HEAR","en":"I'm not sure about this.","pl":"Nie jestem tego pewien.","hint_pl":"Dobrze, że pyta — pokaż mu.","variants":{"alt":[]},"register":"casual","red":false,"tags":["stoisko","crew"],"reply":"No problem, I'll show you."},
  {"id":"t7u6-21","track":"T","module":"T7","unit":6,"type":"HEAR","en":"Coming down! Heads!","pl":"Spada! Uwaga z góry!","hint_pl":"Słyszysz to — odsuń się, nie patrz w górę.","variants":{"alt":[]},"register":"casual","red":false,"tags":["stoisko","crew"],"reply":"Okay, I'm clear!"},
  {"id":"t7u7-01","track":"T","module":"T7","unit":7,"type":"SAY","en":"Where is the power for the screen?","pl":"Gdzie jest zasilanie do ekranu?","hint_pl":"Power = prąd / zasilanie.","variants":{"alt":[]},"register":"polite","red":true,"tags":["stoisko","client"]},
  {"id":"t7u7-02","track":"T","module":"T7","unit":7,"type":"SAY","en":"I need two sockets, sixteen amps.","pl":"Potrzebuję dwóch gniazd, 16 amperów.","hint_pl":"UK: socket, US: outlet. Podstaw swoje wartości.","variants":{"uk":"I need two sockets, sixteen amps.","us":"I need two outlets, sixteen amps."},"register":"polite","red":true,"tags":["stoisko","client"]},
  {"id":"t7u7-03","track":"T","module":"T7","unit":7,"type":"SAY","en":"Who is the stand electrician?","pl":"Kto jest elektrykiem stoiska?","hint_pl":"Electrician czytaj „i-lek-TRY-szen”.","variants":{"alt":[]},"register":"polite","red":false,"tags":["stoisko","client"]},
  {"id":"t7u7-04","track":"T","module":"T7","unit":7,"type":"SAY","en":"Where can I put the processor?","pl":"Gdzie mogę postawić procesor?","hint_pl":"Procesor potrzebuje miejsca blisko ekranu, z prądem.","variants":{"alt":[]},"register":"polite","red":true,"tags":["stoisko","client"]},
  {"id":"t7u7-05","track":"T","module":"T7","unit":7,"type":"SAY","en":"Connect the power, panel to panel.","pl":"Podłącz zasilanie, panel do panelu.","hint_pl":"Daisy chain = łączenie łańcuchowe.","variants":{"alt":[]},"register":"casual","red":true,"tags":["stoisko","crew"]},
  {"id":"t7u7-06","track":"T","module":"T7","unit":7,"type":"SAY","en":"Now the network cables. Follow the arrows.","pl":"Teraz kable sygnałowe. Zgodnie ze strzałkami.","hint_pl":"Strzałki na panelach pokazują kierunek danych.","variants":{"alt":[]},"register":"casual","red":true,"tags":["stoisko","crew"]},
  {"id":"t7u7-07","track":"T","module":"T7","unit":7,"type":"SAY","en":"Data goes in here and out there.","pl":"Sygnał wchodzi tu, a wychodzi tam.","hint_pl":"In / out = wejście / wyjście.","variants":{"alt":[]},"register":"casual","red":false,"tags":["stoisko","crew"]},
  {"id":"t7u7-08","track":"T","module":"T7","unit":7,"type":"SAY","en":"Don't plug in the power yet.","pl":"Jeszcze nie podłączaj prądu.","hint_pl":"Yet = jeszcze. Najpierw sprawdzasz Ty.","variants":{"alt":[]},"register":"casual","red":true,"tags":["stoisko","crew"]},
  {"id":"t7u7-09","track":"T","module":"T7","unit":7,"type":"SAY","en":"Run the cables along the beam.","pl":"Poprowadź kable wzdłuż belki.","hint_pl":"Run cables = prowadzić kable.","variants":{"alt":[]},"register":"casual","red":false,"tags":["stoisko","crew"]},
  {"id":"t7u7-10","track":"T","module":"T7","unit":7,"type":"SAY","en":"Cable ties every fifty centimetres.","pl":"Opaski co pięćdziesiąt centymetrów.","hint_pl":"UK: cable ties, US: zip ties.","variants":{"uk":"Cable ties every fifty centimetres.","us":"Zip ties every fifty centimeters."},"register":"casual","red":false,"tags":["stoisko","crew"]},
  {"id":"t7u7-11","track":"T","module":"T7","unit":7,"type":"SAY","en":"Keep the cables tidy, please.","pl":"Kable mają być porządnie poukładane.","hint_pl":"Tidy = schludny.","variants":{"alt":[]},"register":"casual","red":false,"tags":["stoisko","crew"]},
  {"id":"t7u7-12","track":"T","module":"T7","unit":7,"type":"SAY","en":"Tape this cable to the floor.","pl":"Przyklej ten kabel do podłogi.","hint_pl":"Gaffer tape = taśma gaffer.","variants":{"alt":[]},"register":"casual","red":false,"tags":["stoisko","crew"]},
  {"id":"t7u7-13","track":"T","module":"T7","unit":7,"type":"HEAR","en":"The electrician comes at four.","pl":"Elektryk przyjdzie o czwartej.","hint_pl":"","variants":{"alt":[]},"register":"polite","red":false,"tags":["stoisko","client"],"reply":"Okay, I'll be ready by four."},
  {"id":"t7u7-14","track":"T","module":"T7","unit":7,"type":"HEAR","en":"Is it okay to switch on?","pl":"Mogę włączyć?","hint_pl":"Nigdy nie pozwalaj włączyć bez Twojej kontroli.","variants":{"alt":[]},"register":"casual","red":false,"tags":["stoisko","crew"],"reply":"Wait. Let me check first."},
  {"id":"t7u7-15","track":"T","module":"T7","unit":7,"type":"HEAR","en":"This cable is too short.","pl":"Ten kabel jest za krótki.","hint_pl":"","variants":{"alt":[]},"register":"casual","red":false,"tags":["stoisko","crew"],"reply":"Use the long one from the case."},
  {"id":"t7u8-01","track":"T","module":"T7","unit":8,"type":"SAY","en":"Now we wrap the beams in fabric.","pl":"Teraz opinamy belki tkaniną.","hint_pl":"Wrap = opiąć, owinąć. Fabric = tkanina.","variants":{"alt":[]},"register":"casual","red":true,"tags":["stoisko","crew"]},
  {"id":"t7u8-02","track":"T","module":"T7","unit":8,"type":"SAY","en":"Black fabric, no wrinkles, please.","pl":"Czarna tkanina, bez zmarszczek.","hint_pl":"Wrinkles = zmarszczki / fałdy.","variants":{"alt":[]},"register":"casual","red":true,"tags":["stoisko","crew"]},
  {"id":"t7u8-03","track":"T","module":"T7","unit":8,"type":"SAY","en":"Pull it tight, then velcro it.","pl":"Naciągnij mocno, potem zapnij na rzep.","hint_pl":"Velcro = rzep.","variants":{"alt":[]},"register":"casual","red":true,"tags":["stoisko","crew"]},
  {"id":"t7u8-04","track":"T","module":"T7","unit":8,"type":"SAY","en":"Start from the middle, then go out.","pl":"Zacznij od środka, potem na boki.","hint_pl":"Tak tkanina układa się równo.","variants":{"alt":[]},"register":"casual","red":false,"tags":["stoisko","crew"]},
  {"id":"t7u8-05","track":"T","module":"T7","unit":8,"type":"SAY","en":"Hide all the cables behind the fabric.","pl":"Schowaj wszystkie kable za tkaniną.","hint_pl":"Hide = schować.","variants":{"alt":[]},"register":"casual","red":true,"tags":["stoisko","crew"]},
  {"id":"t7u8-06","track":"T","module":"T7","unit":8,"type":"SAY","en":"Use black cable ties only.","pl":"Używaj tylko czarnych opasek.","hint_pl":"Białe opaski widać na zdjęciach.","variants":{"alt":[]},"register":"casual","red":false,"tags":["stoisko","crew"]},
  {"id":"t7u8-07","track":"T","module":"T7","unit":8,"type":"SAY","en":"Cut the ties short, please.","pl":"Przytnij opaski krótko.","hint_pl":"Ostre końcówki opasek kaleczą ręce.","variants":{"alt":[]},"register":"casual","red":false,"tags":["stoisko","crew"]},
  {"id":"t7u8-08","track":"T","module":"T7","unit":8,"type":"SAY","en":"Keep the fabric away from the LEDs.","pl":"Trzymaj tkaninę z dala od diod.","hint_pl":"Tkanina nie może zasłaniać ani grzać diod.","variants":{"alt":[]},"register":"casual","red":true,"tags":["stoisko","crew"]},
  {"id":"t7u8-09","track":"T","module":"T7","unit":8,"type":"SAY","en":"Does the back look clean?","pl":"Czy tył wygląda czysto?","hint_pl":"Przy transparentnym ekranie tył też widać!","variants":{"alt":[]},"register":"casual","red":false,"tags":["stoisko","crew"]},
  {"id":"t7u8-10","track":"T","module":"T7","unit":8,"type":"SAY","en":"Is the black fabric okay for you?","pl":"Czy czarna tkanina Panu pasuje?","hint_pl":"Zapytaj, zanim opniesz wszystko.","variants":{"alt":[]},"register":"polite","red":true,"tags":["stoisko","client"]},
  {"id":"t7u8-11","track":"T","module":"T7","unit":8,"type":"SAY","en":"Do you want the back covered too?","pl":"Chce Pan, żeby tył też był opięty?","hint_pl":"Covered = zakryty.","variants":{"alt":[]},"register":"polite","red":false,"tags":["stoisko","client"]},
  {"id":"t7u8-12","track":"T","module":"T7","unit":8,"type":"HEAR","en":"The fabric is too short here.","pl":"Tkanina jest tu za krótka.","hint_pl":"","variants":{"alt":[]},"register":"casual","red":false,"tags":["stoisko","crew"],"reply":"No problem, we'll tape it at the back."},
  {"id":"t7u8-13","track":"T","module":"T7","unit":8,"type":"HEAR","en":"Do you have more velcro?","pl":"Masz więcej rzepów?","hint_pl":"","variants":{"alt":[]},"register":"casual","red":false,"tags":["stoisko","crew"],"reply":"Yes, in the black bag."},
  {"id":"t7u8-14","track":"T","module":"T7","unit":8,"type":"HEAR","en":"Like this?","pl":"Tak?","hint_pl":"Stagehand pyta, czy dobrze robi.","variants":{"alt":[]},"register":"casual","red":false,"tags":["stoisko","crew","short"],"reply":"Perfect, just like that."},
  {"id":"t7u9-01","track":"T","module":"T7","unit":9,"type":"SAY","en":"Now I set up the processor.","pl":"Teraz konfiguruję procesor.","hint_pl":"Processor = sterownik/procesor wideo (np. NovaStar).","variants":{"alt":[]},"register":"neutral","red":true,"tags":["stoisko","solo"]},
  {"id":"t7u9-02","track":"T","module":"T7","unit":9,"type":"SAY","en":"I'm loading the configuration file.","pl":"Wgrywam plik konfiguracyjny.","hint_pl":"Config file — u NovaStar plik konfiguracji kart odbiorczych.","variants":{"alt":[]},"register":"neutral","red":false,"tags":["stoisko","solo"]},
  {"id":"t7u9-03","track":"T","module":"T7","unit":9,"type":"SAY","en":"Let me check the receiving cards.","pl":"Sprawdzę karty odbiorcze.","hint_pl":"Receiving card = karta odbiorcza w panelu.","variants":{"alt":[]},"register":"neutral","red":false,"tags":["stoisko","solo"]},
  {"id":"t7u9-04","track":"T","module":"T7","unit":9,"type":"SAY","en":"I'm testing the screen with test patterns.","pl":"Testuję ekran obrazami testowymi.","hint_pl":"Test pattern = obraz testowy (kolory, siatka).","variants":{"alt":[]},"register":"neutral","red":true,"tags":["stoisko","solo"]},
  {"id":"t7u9-05","track":"T","module":"T7","unit":9,"type":"SAY","en":"One panel is dark. I'll check it.","pl":"Jeden panel nie świeci. Sprawdzę go.","hint_pl":"Dark = ciemny, nie świeci.","variants":{"alt":[]},"register":"neutral","red":true,"tags":["stoisko","solo"]},
  {"id":"t7u9-06","track":"T","module":"T7","unit":9,"type":"SAY","en":"The mapping is wrong. I'll fix it.","pl":"Mapowanie jest złe. Poprawię to.","hint_pl":"Mapping = ułożenie paneli w oprogramowaniu.","variants":{"alt":[]},"register":"neutral","red":false,"tags":["stoisko","solo"]},
  {"id":"t7u9-07","track":"T","module":"T7","unit":9,"type":"SAY","en":"I'll set the brightness for indoors.","pl":"Ustawię jasność pod wnętrze.","hint_pl":"Indoor = wewnątrz. Za jasno = źle wygląda na zdjęciach.","variants":{"alt":[]},"register":"neutral","red":false,"tags":["stoisko","solo"]},
  {"id":"t7u9-08","track":"T","module":"T7","unit":9,"type":"SAY","en":"The input is 1920 by 1080.","pl":"Wejście to 1920 na 1080.","hint_pl":"„By” = „na” przy wymiarach.","variants":{"alt":[]},"register":"neutral","red":true,"tags":["stoisko","solo"]},
  {"id":"t7u9-09","track":"T","module":"T7","unit":9,"type":"SAY","en":"Everything works on my laptop.","pl":"Na moim laptopie wszystko działa.","hint_pl":"Twój test przed przekazaniem klientowi.","variants":{"alt":[]},"register":"neutral","red":true,"tags":["stoisko","solo"]},
  {"id":"t7u9-10","track":"T","module":"T7","unit":9,"type":"SAY","en":"I'm saving the settings to the processor.","pl":"Zapisuję ustawienia w procesorze.","hint_pl":"Save = zapisać. Zapisz też kopię u siebie!","variants":{"alt":[]},"register":"neutral","red":true,"tags":["stoisko","solo"]},
  {"id":"t7u9-11","track":"T","module":"T7","unit":9,"type":"SAY","en":"I'll label all the cables for you.","pl":"Opiszę Panu wszystkie kable.","hint_pl":"Label = opisać / etykieta.","variants":{"alt":[]},"register":"neutral","red":false,"tags":["stoisko","solo"]},
  {"id":"t7u9-12","track":"T","module":"T7","unit":9,"type":"SAY","en":"Do you have the content ready?","pl":"Ma Pan gotowe materiały?","hint_pl":"Content = treść / materiały wideo.","variants":{"alt":[]},"register":"polite","red":true,"tags":["stoisko","client"]},
  {"id":"t7u9-13","track":"T","module":"T7","unit":9,"type":"SAY","en":"What resolution is your content?","pl":"Jaka jest rozdzielczość materiałów?","hint_pl":"Resolution = rozdzielczość.","variants":{"alt":[]},"register":"polite","red":true,"tags":["stoisko","client"]},
  {"id":"t7u9-14","track":"T","module":"T7","unit":9,"type":"SAY","en":"Send me a test video, please.","pl":"Proszę mi wysłać wideo testowe.","hint_pl":"Sprawdzisz materiał klienta na swoim PC.","variants":{"alt":[]},"register":"polite","red":false,"tags":["stoisko","client"]},
  {"id":"t7u9-15","track":"T","module":"T7","unit":9,"type":"SAY","en":"I need two hours with no interruptions.","pl":"Potrzebuję dwóch godzin bez przeszkadzania.","hint_pl":"Interruptions = przerywanie.","variants":{"alt":[]},"register":"polite","red":false,"tags":["stoisko","client"]},
  {"id":"t7u9-16","track":"T","module":"T7","unit":9,"type":"HEAR","en":"Why is it flickering?","pl":"Dlaczego migocze?","hint_pl":"Flicker = migotanie.","variants":{"alt":[]},"register":"polite","red":false,"tags":["stoisko","client"],"reply":"Let me check the refresh rate."},
  {"id":"t7u9-17","track":"T","module":"T7","unit":9,"type":"HEAR","en":"Can it be brighter?","pl":"Może być jaśniej?","hint_pl":"","variants":{"alt":[]},"register":"polite","red":false,"tags":["stoisko","client"],"reply":"Yes, but not too bright indoors."},
  {"id":"t7u9-18","track":"T","module":"T7","unit":9,"type":"HEAR","en":"When can we see it?","pl":"Kiedy możemy zobaczyć?","hint_pl":"","variants":{"alt":[]},"register":"polite","red":false,"tags":["stoisko","client"],"reply":"In about one hour."},
  {"id":"t7u9-19","track":"T","module":"T7","unit":9,"type":"HEAR","en":"The colours look strange.","pl":"Kolory wyglądają dziwnie.","hint_pl":"UK: colours, US: colors.","variants":{"alt":[]},"register":"polite","red":false,"tags":["stoisko","client"],"reply":"I'll check the colour settings."},
  {"id":"t7u10-01","track":"T","module":"T7","unit":10,"type":"SAY","en":"Now let's test with your laptop.","pl":"Teraz przetestujmy z Pana laptopem.","hint_pl":"Start przekazania. Klient ma sam to obsługiwać.","variants":{"alt":[]},"register":"polite","red":true,"tags":["stoisko","client"]},
